# ===========================================
# AI 投流复盘分析师 - 环境变量模板
# 复制此文件为 .env 后填入真实值
# ===========================================

# ---------- 必填 ----------
# 通义千问 API Key（申请地址：https://dashscope.console.aliyun.com）
AI_DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 可选 ----------
# 生产环境 Bearer Token 鉴权（未设置则跳过鉴权，开发模式）
# API_KEY=your_random_secret_token_here

# 巨量千川 Access Token（用于 MCP 接入，需要先在巨量引擎开放平台授权）
# 申请地址：https://open.oceanengine.com/mcp?app_id=1837698859935771
# QIANCHUAN_ACCESS_TOKEN=your_qianchuan_access_token_here
